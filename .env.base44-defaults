# Development placeholders for the sandbox preview ONLY.
#
# The app reads its Supabase project at startup and refuses to render without
# these two values, so the dev server cannot boot in a fresh sandbox that has no
# credentials yet. The values below are fake: the shell renders, but sign-in,
# data, uploads and email all fail until the real Supabase project URL and
# anon/publishable key are added from the Secrets page.
#
# This file is listed FIRST in docker-compose.base44.yml, so the platform's
# /run/base44/app.env (listed last) always overrides it.
VITE_SUPABASE_URL=https://placeholder.supabase.co
VITE_SUPABASE_ANON_KEY=development-placeholder-anon-key
