{
  "name": "StockfellAccount",
  "type": "object",
  "properties": {
    "account_holder": {
      "type": "string"
    },
    "balance": {
      "type": "number",
      "default": 0
    },
    "target_amount": {
      "type": "number",
      "default": 0
    },
    "monthly_contribution": {
      "type": "number",
      "default": 0
    },
    "total_contributed": {
      "type": "number",
      "default": 0
    },
    "total_withdrawn": {
      "type": "number",
      "default": 0
    },
    "last_contribution_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "closed"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "account_holder"
  ]
}