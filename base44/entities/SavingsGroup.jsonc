{
  "name": "SavingsGroup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "target_amount": {
      "type": "number",
      "default": 0
    },
    "contribution_amount": {
      "type": "number",
      "default": 0
    },
    "contribution_frequency": {
      "type": "string",
      "enum": [
        "weekly",
        "bi_weekly",
        "monthly"
      ],
      "default": "monthly"
    },
    "current_balance": {
      "type": "number",
      "default": 0
    },
    "member_count": {
      "type": "number",
      "default": 1
    },
    "created_by_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "contributing",
        "completed",
        "cancelled"
      ],
      "default": "open"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "purpose": {
      "type": "string",
      "enum": [
        "shared_savings",
        "bulk_buying",
        "stokvel"
      ],
      "default": "shared_savings"
    }
  },
  "required": [
    "name"
  ]
}